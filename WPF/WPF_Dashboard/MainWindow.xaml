<Window x:Class="WPF_Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSRC Inspired V2V Communication System"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#050B14"
        Foreground="white"
        FontFamily="Segoe UI" Loaded="Window_Loaded" Icon="appimage.jpg">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#8197B1"/>
        <SolidColorBrush x:Key="Panel" Color="#0C1828"/>
        <SolidColorBrush x:Key="LineColor" Color="#223B55"/>

        <Style x:Key="TelltaleBorder" TargetType="Border">
            <Setter Property="Background" Value="#111D2D"/>
            <Setter Property="BorderBrush" Value="#273B52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,12">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Width="9" Height="9"
                         Fill="#00D9FF" Margin="0,0,10,0"/>
                <TextBlock x:Name="mainvehicle" Text="VEHICLE A"
                           FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="mainvehiclestatus" Text="  /  FRONT VEHICLE"
                           FontSize="12" Foreground="#8197B1"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <ComboBox x:Name="combo1"
          Width="150"
          Height="34"
          IsEditable="False"
          SelectedIndex="-1"
          DropDownOpened="dropdownevent"
          Background="#000000"
          Foreground="#00D9FF"
          BorderBrush="#24435D"
          BorderThickness="1"
          FontSize="12"
          Padding="8,5"
          Margin="0,0,10,0">

                    <ComboBox.Resources>
                        <Style TargetType="{x:Type ComboBoxItem}">
                            <Setter Property="Foreground" Value="#00D9FF"/>
                            <Setter Property="Background" Value="#000000"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Style.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter Property="Background" Value="#173B52"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#173B52"/>
                                    <Setter Property="Foreground" Value="#00D9FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Resources>

                    <ComboBox.Template>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <ToggleButton x:Name="DropDownButton"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen,
                                  RelativeSource={RelativeSource TemplatedParent},
                                  Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="#000000"
                                    BorderBrush="#24435D"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="25"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Content="{Binding SelectionBoxItem,
                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        TextElement.Foreground="#00D9FF"/>

                                                    <TextBlock Grid.Column="1"
                                               Text="▾"
                                               Foreground="#00D9FF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Fade">
                                    <Border Background="#000000"
                            BorderBrush="#24435D"
                            BorderThickness="1"
                            Width="{Binding ActualWidth,
                                RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <ScrollViewer MaxHeight="250">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </ComboBox.Template>
                </ComboBox>

                <Button x:Name="ConnectButton"
            Content="CONNECT"
            Width="100"
            Height="34"
            Click="ConnectButton_Click"
            Background="#103047"
            Foreground="#00D9FF"
            BorderBrush="#00D9FF"
            BorderThickness="1"
            FontSize="11"
            FontWeight="Bold"
            Cursor="Hand"
            Margin="0,0,20,0">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                                <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#16435A"/>
                                    <Setter TargetName="ButtonBorder"
                                Property="BorderBrush"
                                Value="#65E8FF"/>
                                </Trigger>

                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#006B82"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder"
                                Property="Opacity"
                                Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="Status"
                           Foreground="#8197B1"
                           FontSize="11"
                           Margin="0,0,18,0"/>
                <TextBlock x:Name="ConnectionText"
                           Text="DISCONNECTED"
                           Foreground="#FF5367"
                           FontSize="11"
                           FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Main cluster -->
        <Border Grid.Row="1"
                Background="#081321"
                BorderBrush="#203750"
                BorderThickness="1"
                CornerRadius="22"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- LOCAL VEHICLE -->
                <Grid Grid.Column="0" Margin="8,0,18,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="LOCAL VEHICLE"
                                   Style="{StaticResource SmallLabel}"/>
                        <TextBlock x:Name="VehicleIdText"
                                   Text="Vehicle A"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>
                        <TextBlock x:Name="VehicleRoleText"
                                   Text="FRONT VEHICLE"
                                   Foreground="#00D9FF"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="VEHICLE SPEED"
                                   Style="{StaticResource SmallLabel}"/>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2,0,0">
                            <TextBlock x:Name="LocalSpeedText"
                                       Text="45.5"
                                       FontSize="64"
                                       FontWeight="Light"
                                       Foreground="#EAF8FF"/>
                            <TextBlock Text=" km/h"
                                       FontSize="15"
                                       Foreground="#8197B1"
                                       VerticalAlignment="Bottom"
                                       Margin="5,0,0,13"/>
                        </StackPanel>

                        <Border Height="1"
                                Background="#223B55"
                                Margin="0,14,0,16"/>

                        <TextBlock Text="DISTANCE"
                                   Style="{StaticResource SmallLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LocalDistanceText"
                                       Text="12.3 m"
                                       FontSize="29"
                                       FontWeight="Medium"/>
                        </StackPanel>

                        <TextBlock Text="TIME TO COLLISION"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,20,0,0"/>
                        <TextBlock x:Name="LocalTtcText"
                                   Text="1.25 s"
                                   FontSize="42"
                                   FontWeight="SemiBold"
                                   Foreground="#FF4F62"
                                   Margin="0,2,0,0"/>

                        <TextBlock Text="STEERING ADVISORY"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,18,0,0"/>
                        <TextBlock x:Name="SteerText"
                                   Text="1"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB547"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="LOCAL SIGNALS"
                               Style="{StaticResource SmallLabel}"/>
                </Grid>

                <!-- CENTRAL PROXIMITY VIEW -->
                <Grid Grid.Column="1" Margin="8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="proxmitystatus" Text="FORWARD PROXIMITY"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SmallLabel}"/>

                    <Grid Grid.Row="1"
                          Width="300" Height="360"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                        <!-- Range rings -->
                        <Ellipse Width="270" Height="270"
                                 Stroke="#1C3853"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                        <Ellipse Width="205" Height="205"
                                 Stroke="#24445F"
                                 StrokeThickness="1"
                                 StrokeDashArray="4,4"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                        <Ellipse Width="140" Height="140"
                                 Stroke="#35516B"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                        <!-- Distance guides -->
                        <Line X1="150" Y1="20" X2="150" Y2="340"
                              Stroke="#25425E"
                              StrokeThickness="1"
                              StrokeDashArray="3,5"/>

                        <!-- Peer vehicle -->
                        <Border x:Name="PeerVehicleVisual"
        Width="76" Height="104"
        Background="#35252A"
        BorderBrush="#FF5367"
        BorderThickness="2"
        CornerRadius="19"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Margin="0,35,0,0">
                            <Grid>
                                <Rectangle x:Name="PeerWindow"
                   Width="43" Height="48"
                   RadiusX="10" RadiusY="10"
                   Fill="#7B414A"
                   Stroke="#FF8793"
                   StrokeThickness="1"
                   VerticalAlignment="Center"/>

                                <Rectangle x:Name="PeerFrontLight"
                   Width="52" Height="14"
                   RadiusX="4" RadiusY="4"
                   Fill="#FF5367"
                   VerticalAlignment="Top"
                   Margin="0,7,0,0"/>

                                <Rectangle x:Name="PeerRearLight"
                   Width="52" Height="12"
                   RadiusX="4" RadiusY="4"
                   Fill="#FF5367"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,7"/>
                            </Grid>
                        </Border>

                        <!-- Local vehicle -->
                        <Border x:Name="LocalVehicleVisual"
        Width="76" Height="104"
        Background="#102C42"
        BorderBrush="#00D9FF"
        BorderThickness="2"
        CornerRadius="19"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="0,0,0,35">
                            <Grid>
                                <Rectangle x:Name="LocalWindow"
                   Width="43" Height="48"
                   RadiusX="10" RadiusY="10"
                   Fill="#1B6681"
                   Stroke="#65E8FF"
                   StrokeThickness="1"
                   VerticalAlignment="Center"/>

                                <Rectangle x:Name="LocalFrontLight"
                   Width="52" Height="14"
                   RadiusX="4" RadiusY="4"
                   Fill="#00D9FF"
                   VerticalAlignment="Top"
                   Margin="0,7,0,0"/>

                                <Rectangle x:Name="LocalRearLight"
                   Width="52" Height="12"
                   RadiusX="4" RadiusY="4"
                   Fill="#00D9FF"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,7"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center">
                        <TextBlock Text="PEER VEHICLE"
                                   Foreground="#FFB547"
                                   FontSize="11"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PeerDistanceText"
                                   Text="15.5 m"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- PEER DATA + STATUS -->
                <Grid Grid.Column="2" Margin="18,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="PEER VEHICLE"
                                   Style="{StaticResource SmallLabel}"/>
                        <TextBlock Text="RELATIVE DATA"
                                   FontSize="12"
                                   Foreground="#FFB547"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="PEER SPEED"
                                   Style="{StaticResource SmallLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PeerSpeedText"
                                       Text="40"
                                       FontSize="54"
                                       FontWeight="Light"/>
                            <TextBlock Text=" km/h"
                                       FontSize="14"
                                       Foreground="#8197B1"
                                       VerticalAlignment="Bottom"
                                       Margin="5,0,0,12"/>
                        </StackPanel>

                        <Border Height="1"
                                Background="#223B55"
                                Margin="0,16,0,16"/>

                        <TextBlock Text="PEER TTC"
                                   Style="{StaticResource SmallLabel}"/>
                        <TextBlock x:Name="PeerTtcText"
                                   Text="2.40 s"
                                   FontSize="36"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB547"
                                   Margin="0,4,0,0"/>

                        <TextBlock Text="SPEED DIFFERENCE"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,22,0,0"/>
                        <TextBlock x:Name="SpeedDifferenceText"
                                   Text="+5.5 km/h"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#00D9FF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="VEHICLE STATUS"
                                   Style="{StaticResource SmallLabel}"
                                   Margin="0,0,0,8"/>

                        <Border Background="#301923"
                                BorderBrush="#6A2938"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="SYSTEM STATUS"
                                           Foreground="#B88A95"
                                           FontSize="10"/>
                                <TextBlock x:Name="StatusText"
                                           Text="DANGER"
                                           Foreground="#FF5367"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Automotive telltale strip -->
        <Border Grid.Row="2"
                Background="#070E19"
                BorderBrush="#22364B"
                BorderThickness="1"
                CornerRadius="14"
                Padding="10"
                Margin="0,14,0,0">

            <UniformGrid Columns="5">

                <Border x:Name="CollisionTelltale"
                        Style="{StaticResource TelltaleBorder}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="⚠"
                                   FontSize="25"
                                   Foreground="#FF5367"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="COLLISION"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF697B"/>
                            <TextBlock Text="WARNING"
                                       FontSize="9"
                                       Foreground="#A57B86"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="LocalBrakeBadge"
                        Style="{StaticResource TelltaleBorder}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="(!)"
                                   FontSize="23"
                                   Foreground="#FF5367"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LocalBrakeText"
                                       Text="BRAKE ACTIVE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FF697B"/>
                            <TextBlock Text="LOCAL VEHICLE"
                                       FontSize="9"
                                       Foreground="#A57B86"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="LocalObstacleBadge"
                        Style="{StaticResource TelltaleBorder}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="▲"
                                   FontSize="24"
                                   Foreground="#71849B"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LocalObstacleText"
                                       Text="OBSTACLE CLEAR"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8197B1"/>
                            <TextBlock Text="DETECTION"
                                       FontSize="9"
                                       Foreground="#71849B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="SteeringTelltale"
                        Style="{StaticResource TelltaleBorder}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock x:Name="streeingdir"
                                   Text="↔"
                                   FontSize="26"
                                   Foreground="#FFB547"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="STEERING"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFB547"/>
                            <TextBlock Text="ADVISORY"
                                       FontSize="9"
                                       Foreground="#9C8969"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="PeerBrakeBadge"
                        Style="{StaticResource TelltaleBorder}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="🚘"
                                   FontSize="22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PEER VEHICLE"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#00D9FF"/>
                            <TextBlock Text="TRACKING"
                                       FontSize="9"
                                       Foreground="#8197B1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="4,4,4,0">
            <TextBlock Text="DSRC Inspired V2V Communication System &#x0a;
                       Rohitkumar RG    - 23626619 &#x0a;
                       Santhosh Rajavel - 23626622
"
                       Foreground="#607A97"
                       FontSize="10"
                       VerticalAlignment="Center"/>
            <TextBlock Text="VELS University"
                       Foreground="#607A97"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
